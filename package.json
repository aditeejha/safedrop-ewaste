{
  "name": "safedrop-ewaste",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "web",
    "api",
    "infra"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run dev -w api",
    "build": "npm run build -w api && npm run build -w web",
    "test": "npm test -w api",
    "typecheck": "npm run typecheck -w api && npm run typecheck -w web && npm run typecheck -w infra",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1149.0",
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/client-geo-places": "^3.1149.0",
    "@aws-sdk/lib-dynamodb": "^3.1149.0"
  }
}
